{
  "name": "mercora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "predev": "node scripts/db-local-ensure.mjs",
    "dev": "next dev --turbopack",
    "db:local": "node scripts/db-local-ensure.mjs",
    "db:reset:local": "wrangler d1 migrations apply beauteas-db-dev --local --env dev && wrangler d1 execute beauteas-db-dev --local --env dev --file data/d1/seed.sql && wrangler d1 execute beauteas-db-dev --local --env dev --file data/d1/seed-dev.sql",
    "r2:local": "node scripts/r2-local-ensure.mjs",
    "seed:local": "node scripts/db-local-ensure.mjs && node scripts/r2-local-ensure.mjs",
    "enrich:dev": "node scripts/enrich-catalog.mjs --env dev",
    "enrich:production": "node scripts/enrich-catalog.mjs --env production",
    "images:sync": "node scripts/sync-images.mjs",
    "db:dump": "node scripts/db-dump.mjs --env dev",
    "db:migrate:dev": "node scripts/d1-migrate.mjs --env dev",
    "db:migrate:production": "node scripts/d1-migrate.mjs --env production",
    "db:migrate:status:dev": "node scripts/d1-migrate.mjs --env dev --dry-run",
    "db:migrate:status:production": "node scripts/d1-migrate.mjs --env production --dry-run",
    "build": "next build",
    "build:open-next": "node scripts/build-with-env.mjs production opennextjs-cloudflare build",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "start": "next start",
    "lint": "next lint",
    "predeploy:dev": "npm run db:migrate:dev",
    "deploy:dev": "npm run clean && node scripts/build-with-env.mjs dev opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "predeploy:production": "if [ ! -f wrangler.jsonc ]; then echo 'ERROR: wrangler.jsonc not found.' >&2; exit 1; fi; if grep -q 'REPLACE_WITH_' wrangler.jsonc; then echo 'ERROR: wrangler.jsonc contains REPLACE_WITH_ placeholder(s). Fill in live keys before deploying to production.' >&2; exit 1; fi && npm run db:migrate:production",
    "deploy:production": "npm run clean && node scripts/build-with-env.mjs production opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "clean": "rm -rf .open-next .next .wrangler/state .wrangler/public",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:dev": "npm run seed:local && node scripts/build-with-env.mjs dev opennextjs-cloudflare build && wrangler dev --env dev --port 3217",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "token:generate": "tsx scripts/manage-tokens.ts generate",
    "token:list": "tsx scripts/manage-tokens.ts list",
    "token:revoke": "tsx scripts/manage-tokens.ts revoke",
    "images:pages": "tsx scripts/migrate-page-images.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.5",
    "@clerk/themes": "^2.4.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@react-email/components": "^0.4.0",
    "@react-email/render": "^1.1.4",
    "@shadcn/ui": "^0.0.4",
    "@stripe/react-stripe-js": "^3.9.0",
    "@stripe/stripe-js": "^7.8.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-typography": "^3.27.1",
    "@tiptap/html": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/sanitize-html": "^2.16.1",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "3.21.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.525.0",
    "marked": "^16.3.0",
    "nanoid": "^5.1.6",
    "next": "15.5.22",
    "novel": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "resend": "^4.8.0",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "sonner": "^2.0.6",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.3.1",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@clerk/backend": "^2.33.5",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@playwright/test": "^1.61.1",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "csv-parse": "^6.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.22",
    "jsdom": "^29.1.1",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "brace-expansion": "2.1.3",
    "linkify-it": "6.1.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
