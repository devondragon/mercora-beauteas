/**
 * Wrangler Configuration for BeauTeas
 *
 * Multi-environment setup:
 *   - dev: Development/staging environment
 *   - production: Live production environment
 *
 * Deploy commands:
 *   npm run build && wrangler deploy --env dev
 *   npm run build && wrangler deploy --env production
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauteas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Shared configuration (inherited by all environments, except bindings).
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": []
  },

  // Environment-specific configurations
  "env": {
    // === DEV ENVIRONMENT ===
    "dev": {
      "name": "beauteas-dev",
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "beauteas-db-dev",
          "database_id": "f88149dc-32c3-4a04-9c02-95e25db6d735",
          "preview_database_id": "0a037b06-421c-484e-8b17-140a5741c1ef"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "beauteas-images-dev",
          "preview_bucket_name": "beauteas-images-dev-preview"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "beauteas-images-dev",
          "preview_bucket_name": "beauteas-images-dev-preview"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "beauteas-index-dev"
        }
      ],
      // Money-path metrics (BMC-168). Distinct dataset per env so dev/prod
      // counters never mix. Dataset is auto-created on first writeDataPoint.
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "beauteas_money_events_dev"
        }
      ],
      // Ship every invocation's traces to the observability Tail Worker (BMC-168)
      // for exception/[critical] alerting. Deploy that Worker BEFORE this one.
      "tail_consumers": [
        {
          "service": "beauteas-observability-tail-dev"
        }
      ],
      // Per-IP abuse limiters (BMC-180). AI_RATE_LIMITER guards the paid AI path
      // (/api/agent-chat); PUBLIC_RATE_LIMITER guards the other public POSTs
      // (tax, validate-discount, gift-cards/validate, payment-intent). Native CF
      // rate limiting: best-effort, per-colo. namespace_ids are distinct from
      // production so dev/prod counters never share. period must be 10 or 60.
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "vars": {
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_YnVzeS1zaHJpbXAtNDkuY2xlcmsuYWNjb3VudHMuZGV2JA",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51ToUoXFdZ6iCcQWyo4eO3JBmMNcP9svR3B1ARPFgXoJ1AL8mF8l0bhFU3PoxfSHqN1DT9zYIpEGSwSFiivh1Q8yV00T7ko8aoj",
        // Canonical host for this environment — drives canonical tags, OG URLs,
        // sitemap, JSON-LD and email links (lib/seo/metadata.ts).
        "NEXT_PUBLIC_SITE_URL": "https://beauteas-dev.workers.dev"
      }
    },

    // === PRODUCTION ENVIRONMENT ===
    "production": {
      "name": "beauteas",
      // Custom domains. `shop.` is the STAGING/validation host while Shopify
      // still serves customers on www — adding a subdomain does not touch the
      // www or apex records. At cutover (runbook Phase 10) add
      // { "pattern": "www.beauteas.com", "custom_domain": true }, which TAKES
      // OVER the www DNS record currently pointing at Shopify — that flip is
      // the cutover itself.
      "routes": [
        { "pattern": "shop.beauteas.com", "custom_domain": true }
      ],
      "ai": {
        "binding": "AI"
      },
      // Bindings are not inherited by Wrangler environments. Keep this explicit
      // (even though it is empty) to match dev and prevent deploy warnings.
      "durable_objects": {
        "bindings": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "beauteas-db",
          "database_id": "5dbae836-ff0f-420c-9ac0-16088ceb60ee"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "beauteas-images"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "beauteas-images"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "beauteas-index"
        }
      ],
      // Money-path metrics (BMC-168) — see dev env above. Distinct prod dataset.
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "beauteas_money_events"
        }
      ],
      // Ship every invocation's traces to the observability Tail Worker (BMC-168).
      // Deploy `beauteas-observability-tail` BEFORE deploying this Worker.
      "tail_consumers": [
        {
          "service": "beauteas-observability-tail"
        }
      ],
      // Per-IP abuse limiters (BMC-180) — see dev env above. Distinct
      // namespace_ids so production counters are isolated from dev.
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "vars": {
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYmVhdXRlYXMuY29tJA",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_51ToUnwFqgbQQDjYVOBmnslSy2KuWoO7QzGrK2YqzcIkMRzwRFArKZKdKmiYzHwVhlP8AH4BSe4wxEBrFu3wUoP4A00pcTyYHLm",
        "NEXT_PUBLIC_IMAGE_CDN": "https://img.beauteas.com",
        // Cloudflare Image Transformations (/cdn-cgi/image/...). REQUIRES
        // Transformations enabled for the beauteas.com zone — it was off on
        // 2026-07-27 and every product image 404'd. Enabled since.
        // ESCAPE HATCH: set to "false" and redeploy to serve raw objects from
        // the CDN host instead (bigger, ~917KB vs ~108KB, but never broken).
        "NEXT_PUBLIC_IMAGE_TRANSFORMS": "true",
        // ⚠️ CUTOVER ACTION (runbook Phase 10): change to "https://www.beauteas.com"
        // and REBUILD + REDEPLOY. This is baked into the client bundle at build
        // time, so editing it without a rebuild has no effect.
        //
        // Currently set to the staging host so that while the production Worker
        // is validated on shop.beauteas.com (Shopify still live on www), its
        // canonicals, sitemap, JSON-LD and email links point at shop — not at
        // the Shopify store.
        "NEXT_PUBLIC_SITE_URL": "https://shop.beauteas.com"
      }
    }
  }

  /**
   * Secrets (set per environment):
   *   wrangler secret put CLERK_SECRET_KEY --env dev
   *   wrangler secret put STRIPE_SECRET_KEY --env dev
   *   wrangler secret put STRIPE_WEBHOOK_SECRET --env dev
   *   wrangler secret put RESEND_API_KEY --env dev
   *
   *   wrangler secret put CLERK_SECRET_KEY --env production
   *   wrangler secret put STRIPE_SECRET_KEY --env production
   *   wrangler secret put STRIPE_WEBHOOK_SECRET --env production
   *   wrangler secret put RESEND_API_KEY --env production
   */
}
